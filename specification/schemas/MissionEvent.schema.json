        "plan_rejected",
        "skill_state",
        "assessment",
        "assessment_unknown",
        "extension_warning",
        "provider_selected",
        "lease_acquired",
        "lease_renewed",
        "lease_released",
        "command_rejected",
        "verification",
        "effects_committed",
        "reconciled_success",
        "reconciled_absent",
        "reconcile_blocked",
        "recovery_retry",
        "epoch_bumped",
        "sim_step",
        "sim_pause",
        "mission_canceled",
        "mission_finished"
